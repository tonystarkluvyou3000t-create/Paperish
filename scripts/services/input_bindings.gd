extends RefCounted
## Pure input-map helpers: serialize bindings for settings persistence, apply a
## stored binding set onto InputMap, detect conflicts and render prompt labels
## from the current bindings. No state of its own.

## Actions the controls screen offers. Names must exist in InputMap (they are
## generated by tools/setup_project.gd).
const LABELS := {
	"move_forward": "MOVE FORWARD",
	"move_back": "MOVE BACK",
	"move_left": "MOVE LEFT",
	"move_right": "MOVE RIGHT",
	"interact": "INTERACT  ·  enter van / pick up / deliver",
	"handbrake": "HANDBRAKE",
	"horn": "HORN",
	"confirm": "START SHIFT / CONFIRM",
	"cam_orbit": "CAMERA ORBIT (mouse)",
	"cam_recenter": "CAMERA RECENTER",
	"cam_free": "FREE CAMERA",
	"free_up": "FLY CAMERA UP",
	"free_down": "FLY CAMERA DOWN",
	"free_boost": "FLY CAMERA BOOST",
}

const MOUSE_NAMES := {
	MOUSE_BUTTON_LEFT: "LMB",
	MOUSE_BUTTON_RIGHT: "RMB",
	MOUSE_BUTTON_MIDDLE: "MMB",
	MOUSE_BUTTON_WHEEL_UP: "WHEEL UP",
	MOUSE_BUTTON_WHEEL_DOWN: "WHEEL DOWN",
	MOUSE_BUTTON_WHEEL_LEFT: "WHEEL LEFT",
	MOUSE_BUTTON_WHEEL_RIGHT: "WHEEL RIGHT",
}

const PAD_NAMES := {
	JOY_BUTTON_A: "PAD A", JOY_BUTTON_B: "PAD B", JOY_BUTTON_X: "PAD X", JOY_BUTTON_Y: "PAD Y",
	JOY_BUTTON_LEFT_SHOULDER: "PAD LB", JOY_BUTTON_RIGHT_SHOULDER: "PAD RB",
	JOY_BUTTON_BACK: "PAD BACK", JOY_BUTTON_START: "PAD START",
	JOY_BUTTON_LEFT_STICK: "PAD LS", JOY_BUTTON_RIGHT_STICK: "PAD RS",
	JOY_BUTTON_DPAD_UP: "PAD UP", JOY_BUTTON_DPAD_DOWN: "PAD DOWN",
	JOY_BUTTON_DPAD_LEFT: "PAD LEFT", JOY_BUTTON_DPAD_RIGHT: "PAD RIGHT",
}

## Settings-file shape for one event. Variants only, never live objects.
static func serialize(event: InputEvent) -> Dictionary:
	if event is InputEventKey:
		var key := event as InputEventKey
		return {"type": "key", "code": int(key.physical_keycode), "device": key.device}
	if event is InputEventMouseButton:
		var mouse := event as InputEventMouseButton
		return {"type": "mouse", "button": int(mouse.button_index), "device": mouse.device}
	if event is InputEventJoypadButton:
		var pad := event as InputEventJoypadButton
		return {"type": "joy_button", "button": int(pad.button_index), "device": pad.device}
	if event is InputEventJoypadMotion:
		var axis := event as InputEventJoypadMotion
		return {"type": "joy_axis", "axis": int(axis.axis), "value": axis.axis_value, "device": axis.device}
	return {}


static func deserialize(data: Dictionary) -> InputEvent:
	var device := int(data.get("device", -1))
	match str(data.get("type", "")):
		"key":
			var key := InputEventKey.new()
			key.device = device
			key.physical_keycode = int(data.get("code", KEY_NONE)) as Key
			if key.physical_keycode == KEY_NONE:
				return null
			return key
		"mouse":
			var mouse := InputEventMouseButton.new()
			mouse.device = device
			mouse.button_index = int(data.get("button", MOUSE_BUTTON_NONE)) as MouseButton
			if mouse.button_index == MOUSE_BUTTON_NONE:
				return null
			return mouse
		"joy_button":
			var pad := InputEventJoypadButton.new()
			pad.device = device
			pad.button_index = int(data.get("button", JOY_BUTTON_INVALID)) as JoyButton
			if pad.button_index == JOY_BUTTON_INVALID:
				return null
			return pad
		"joy_axis":
			var axis := InputEventJoypadMotion.new()
			axis.device = device
			axis.axis = int(data.get("axis", JOY_AXIS_INVALID)) as JoyAxis
			axis.axis_value = float(data.get("value", 1.0))
			if axis.axis == JOY_AXIS_INVALID:
				return null
			return axis
	return null


static func serialize_all(actions: Array) -> Dictionary:
	var out := {}
	for action in actions:
		var list := []
		for event in InputMap.action_get_events(action):
			var data := serialize(event)
			if not data.is_empty():
				list.append(data)
		out[action] = list
	return out


## Replace each listed action's events with the stored set. Empty or invalid
## stored sets fall back to `defaults` so a critical action is never cleared.
static func apply(bindings: Dictionary, actions: Array, defaults: Dictionary) -> void:
	for action in actions:
		if not InputMap.has_action(action):
			continue
		var events: Array = []
		for data in bindings.get(action, []):
			if typeof(data) == TYPE_DICTIONARY:
				var event := deserialize(data)
				if event != null:
					events.append(event)
		if events.is_empty():
			for event in defaults.get(action, []):
				if event is InputEvent:
					events.append(event)
		InputMap.action_erase_events(action)
		for event in events:
			InputMap.action_add_event(action, event)


## First event of every remappable action, for seeding defaults and resetting.
static func capture_all(actions: Array) -> Dictionary:
	var out := {}
	for action in actions:
		var list: Array = []
		for event in InputMap.action_get_events(action):
			list.append((event as InputEvent).duplicate())
		out[action] = list
	return out


## Name of the other action already using `event`, or "" when free. Builtin
## `ui_*` actions are exempt: Enter/Esc must keep working for menus.
static func conflict(action: String, event: InputEvent) -> String:
	var wanted := _signature(serialize(event))
	if wanted.is_empty():
		return ""
	for other in InputMap.get_actions():
		if other == action or str(other).begins_with("ui_"):
			continue
		for existing in InputMap.action_get_events(other):
			if _signature(serialize(existing)) == wanted:
				return str(other)
	return ""


static func _signature(data: Dictionary) -> String:
	match str(data.get("type", "")):
		"key": return "key:%d" % int(data.get("code", 0))
		"mouse": return "mouse:%d" % int(data.get("button", 0))
		"joy_button": return "joy_button:%d" % int(data.get("button", 0))
		"joy_axis": return "joy_axis:%d:%d" % [int(data.get("axis", 0)), signi(int(round(float(data.get("value", 1.0)) * 2.0)))]
	return ""


static func key_label(code: int) -> String:
	if code == KEY_NONE:
		return ""
	return OS.get_keycode_string(code as Key).to_upper()


## Human label for the action's primary binding, for prompts and chips.
static func prompt(action: String) -> String:
	for event in InputMap.action_get_events(action):
		var text := event_label(event)
		if not text.is_empty():
			return text
	return "UNBOUND"


static func event_label(event: InputEvent) -> String:
	if event is InputEventKey:
		return key_label(int((event as InputEventKey).physical_keycode))
	if event is InputEventMouseButton:
		var index := int((event as InputEventMouseButton).button_index)
		return MOUSE_NAMES.get(index, "MOUSE %d" % index)
	if event is InputEventJoypadButton:
		var button := int((event as InputEventJoypadButton).button_index)
		if button == JOY_BUTTON_INVALID:
			return ""
		return PAD_NAMES.get(button, "PAD %d" % button)
	if event is InputEventJoypadMotion:
		return "STICK"
	return ""


## Every binding of an action as one row string, e.g. "W · ↑".
static func prompt_all(action: String) -> String:
	var parts: Array[String] = []
	for event in InputMap.action_get_events(action):
		var text := event_label(event)
		if not text.is_empty():
			parts.append(text)
	return "  ·  ".join(parts)
