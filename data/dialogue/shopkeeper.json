{
  "id": "shopkeeper",
  "speaker": { "name": "MONA", "color": "f4bb4d" },
  "cancel": "pause",
  "entry": [
    { "when": [{ "kind": "lifecycle", "is": "on_route" }, { "kind": "queue" }], "node": "queue_offer" },
    { "when": [{ "kind": "cargo", "op": "gt", "value": 0 }], "node": "again" },
    { "when": [{ "kind": "lifecycle", "is": "on_route" }], "node": "again" },
    { "when": [{ "kind": "ticket", "is": "preparing" }], "node": "preparing" },
    { "when": [{ "kind": "ticket", "is": "ready" }], "node": "greet" },
    { "node": "greet" }
  ],
  "nodes": [
    {
      "id": "preparing",
      "text": "Ticket #{{order_id}} for {{customer}} at {{address}} is in the oven. {{pizzas}} boxes coming right up!",
      "choices": [
        { "label": "I'LL WAIT A MOMENT", "next": "" },
        { "label": "NOT YET", "next": "" }
      ]
    },
    {
      "id": "greet",
      "text": "Ticket #{{order_id}} is ready for {{customer}} at {{address}}: {{pizzas}} pizza boxes.",
      "choices": [
        { "label": "TAKE {{pizzas}} PIZZAS", "next": "handover" },
        { "label": "NOT YET", "next": "" }
      ]
    },
    {
      "id": "handover",
      "text": "Here you go, Pip! Take the boxes to {{address}}. Your van is parked out front.",
      "commit": "received",
      "effects": [{ "kind": "order", "do": "pick_up" }]
    },
    {
      "id": "again",
      "text": "That ticket is already in your hands, Pip. Drive safe!"
    },
    {
      "id": "queue_offer",
      "text": "I can start another ticket while you're out. The shop can queue up to three orders, and the van has room for six boxes.",
      "choices": [
        { "label": "QUEUE ANOTHER ORDER", "next": "queued" },
        { "label": "NOT NOW", "next": "" }
      ]
    },
    {
      "id": "queued",
      "text": "All set. I'll have it ready at the counter.",
      "commit": "queued",
      "effects": [{ "kind": "order", "do": "queue" }]
    }
  ]
}
