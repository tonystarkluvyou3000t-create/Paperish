      "do": "press",
      "action": "cam_zoom_in"
    },
    {
      "at": 8.1,
      "do": "up",
      "action": "handbrake"
    },
    {
      "at": 8.3,
      "do": "shot",
      "name": "03_zoom_in"
    },
    {
      "at": 8.5,
      "do": "press",
      "action": "cam_zoom_out"
    },
    {
      "at": 8.62,
      "do": "press",
      "action": "cam_zoom_out"
    },
    {
