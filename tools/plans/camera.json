{
  "name": "camera",
  "dir": "res://.godot/phase04-evidence",
  "timeout": 90,
  "steps": [
    {
      "at": 0.4,
      "do": "start"
    },
    {
      "at": 0.6,
      "do": "assert",
      "label": "on foot with the follow camera",
      "expect": {
        "camera_mode": "foot",
        "paused": false
      }
    },
    {
      "at": 0.7,
      "do": "down",
      "action": "cam_orbit"
    },
    {
      "at": 0.8,
      "do": "mouse_motion",
      "dx": 300,
      "dy": -90
    },
    {
      "at": 0.9,
      "do": "mouse_motion",
      "dx": 220,
      "dy": -40
    },
    {
      "at": 1.0,
      "do": "up",
      "action": "cam_orbit"
    },
    {
      "at": 1.1,
      "do": "assert",
      "label": "right-drag orbit keeps the foot camera",
      "expect": {
        "camera_mode": "foot"
      }
    },
    {
      "at": 1.2,
      "do": "shot",
      "name": "01_foot_orbit"
    },
    {
      "at": 1.4,
      "do": "state"
    },
    {
      "at": 1.45,
      "do": "wait",
      "timeout": 3,
      "label": "ticket is ready before deadline camera checks",
      "expect": {
        "ticket_state": "ready"
      }
    },
    {
      "at": 1.6,
      "do": "place",
      "node": "pip",
      "target": "counter"
    },
    {
      "at": 1.7,
      "do": "press",
      "action": "interact"
    },
    {
      "at": 1.8,
      "do": "talk",
      "pick": 0,
      "expect": {
        "order_lifecycle": "on_route",
        "timer_visible": true
      }
    },
    {
      "at": 2.5,
      "do": "press",
      "action": "cam_free"
    },
    {
      "at": 2.6,
      "do": "wait",
      "timeout": 2,
      "label": "free camera opens and pauses",
      "expect": {
        "camera_mode": "free",
        "paused": true
      }
    },
    {
      "at": 2.65,
      "do": "remember",
      "name": "frozen"
    },
    {
      "at": 2.7,
      "do": "down",
      "action": "free_forward"
    },
    {
      "at": 2.8,
      "do": "down",
      "action": "free_up"
    },
    {
      "at": 2.9,
      "do": "down",
      "action": "free_boost"
    },
    {
      "at": 3.0,
      "do": "down",
      "action": "move_forward"
    },
    {
      "at": 3.6,
      "do": "up",
      "action": "free_forward"
    },
    {
      "at": 3.6,
      "do": "up",
      "action": "free_up"
    },
    {
      "at": 3.6,
      "do": "up",
      "action": "free_boost"
    },
    {
      "at": 3.6,
      "do": "up",
      "action": "move_forward"
    },
    {
      "at": 3.7,
      "do": "mouse_motion",
      "dx": 0,
      "dy": 260
    },
    {
      "at": 3.8,
      "do": "assert",
      "label": "deadline frozen inside the free camera",
      "expect": {
        "camera_mode": "free",
        "timer": {
          "op": "eq",
          "saved": "frozen.timer"
        }
      }
    },
    {
      "at": 3.9,
      "do": "assert",
      "label": "camera WASD never moves the van",
      "expect": {
        "van_x": {
          "op": "eq",
          "saved": "frozen.van_x"
        },
        "van_z": {
          "op": "eq",
          "saved": "frozen.van_z"
        }
      }
    },
    {
      "at": 4.0,
      "do": "shot",
      "name": "05_free_aerial"
    },
    {
      "at": 4.1,
      "do": "press",
      "action": "cam_free"
    },
    {
      "at": 4.2,
      "do": "wait",
      "timeout": 2,
      "label": "free camera closes",
      "expect": {
        "camera_mode": "foot",
        "paused": false
      }
    },
    {
      "at": 4.3,
      "do": "wait",
      "timeout": 6,
      "label": "deadline clock resumes",
      "expect": {
        "timer": {
          "op": "lt",
          "saved": "frozen.timer"
        }
      }
    },
    {
      "at": 4.5,
      "do": "place",
      "node": "pip",
      "target": "van_left"
    },
    {
      "at": 4.7,
      "do": "press",
      "action": "interact"
    },
    {
      "at": 4.9,
      "do": "wait",
      "timeout": 3,
      "label": "driving chase engaged",
      "expect": {
        "driving": true,
        "camera_mode": "chase"
      }
    },
    {
      "at": 5.0,
      "do": "down",
      "action": "move_forward"
    },
    {
      "at": 6.1,
      "do": "up",
      "action": "move_forward"
    },
    {
      "at": 6.2,
      "do": "down",
      "action": "handbrake"
    },
    {
      "at": 6.3,
      "do": "down",
      "action": "cam_orbit"
    },
    {
      "at": 6.4,
      "do": "mouse_motion",
      "dx": 520,
      "dy": 40
    },
    {
      "at": 6.5,
      "do": "up",
      "action": "cam_orbit"
    },
    {
      "at": 6.6,
      "do": "assert",
      "label": "manual driving look stays in chase",
      "expect": {
        "driving": true,
        "camera_mode": "chase"
      }
    },
    {
      "at": 6.7,
      "do": "shot",
      "name": "02_chase_rear"
    },
    {
      "at": 6.9,
      "do": "press",
      "action": "cam_zoom_in"
    },
    {
