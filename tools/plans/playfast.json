{
  "name": "playfast",
  "seed": 20261018,
  "timeout": 60,
  "steps": [
    {
      "do": "order",
      "destination_id": "2 Marinara Way"
    },
    {
      "do": "press",
      "action": "confirm"
    },
    {
      "do": "wait",
      "timeout": 3,
      "expect": {
        "mode": "to_shop",
        "order_id": 1
      }
    },
    {
      "do": "remember",
      "name": "ticket"
    },
    {
      "do": "order",
      "destination_id": "4 Marinara Way"
    },
    {
      "do": "place",
      "node": "pip",
      "target": "pickup"
    },
    {
      "do": "press",
      "action": "interact"
    },
    {
      "do": "wait",
      "timeout": 3,
      "expect": {
        "mode": "to_house",
        "cargo_count": {
          "op": "gte",
          "value": 1
        }
      }
    },
    {
      "do": "assert",
      "label": "correct destination and cargo",
      "expect": {
        "destination_id": "2 Marinara Way",
        "cargo_count": {
          "op": "eq",
          "saved": "ticket.order_pizzas"
        }
      }
    },
    {
      "do": "shot",
      "name": "delivery_0_pickup"
    },
    {
      "do": "place",
      "node": "pip",
      "target": "van_left"
    },
    {
      "do": "press",
      "action": "interact"
    },
    {
      "do": "wait",
      "timeout": 3,
      "expect": {
        "driving": true,
        "pip_control": false,
        "van_control": true
      }
    },
    {
      "do": "place",
      "node": "van",
      "target": "park",
      "yaw": 0
    },
    {
      "do": "wait",
      "timeout": 3,
      "expect": {
        "van_stopped": true
      }
    },
    {
      "do": "press",
      "action": "interact"
    },
    {
      "do": "wait",
      "timeout": 3,
      "expect": {
        "driving": false,
        "pip_control": true,
        "van_control": false
      }
    },
    {
      "do": "place",
      "node": "pip",
      "target": "door"
    },
    {
      "do": "press",
      "action": "interact"
    },
    {
      "do": "wait",
      "timeout": 3,
      "expect": {
        "mode": "to_shop",
        "deliveries": 1,
        "cargo_count": 0,
        "strikes": 0
      }
    },
    {
      "do": "assert",
      "label": "next ticket created",
      "expect": {
        "order_id": 2,
        "destination_id": "4 Marinara Way",
        "money": {
          "op": "gt",
          "value": 0
        }
      }
    },
    {
      "do": "remember",
      "name": "paid"
    },
    {
      "do": "retry_delivery"
    },
    {
      "do": "assert",
      "label": "delivery pays once",
      "expect": {
        "money": {
          "op": "eq",
          "saved": "paid.money"
        },
        "deliveries": 1
      }
    },
    {
      "do": "shot",
      "name": "delivery_0_paid"
    },
    {
      "do": "state"
    },
    {
      "do": "quit"
    }
  ]
}
